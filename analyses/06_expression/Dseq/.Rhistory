# Prepare dataset
x_data <- subset(data_baixa, select = -c(WU_Real_Losses_L, WU_NRW, WU_Real_Losses, WU_NRW_L))
y_data <- factor(data_baixa$WU_Real_Losses_L, levels = c("Good","Medium","Unsatisfactory","NR"))
# Convert all variables to numeric
x_data[] <- lapply(x_data, function(x) if(is.factor(x) | is.character(x)) as.numeric(as.factor(x)) else x)
x_data <- as.data.frame(x_data)
# Remove columns with zero variance
zero_var_cols <- which(apply(x_data, 2, function(x) var(x) == 0))
if(length(zero_var_cols) > 0){
x_data <- x_data[, -zero_var_cols]
}
data_knn <- cbind(WU_Real_Losses_L = y_data, x_data)
# Create 10 CV fold index
set.seed(123)
folds <- sample(rep(1:10, length.out = nrow(data_knn)))
k_val <- 10
cv_results <- data.frame(Fold = 1:10, MisclassRate = NA)
# Loop over fold
for(f in 1:10){
train_fold <- data_knn[folds != f, ]
test_fold  <- data_knn[folds == f, ]
model <- train.kknn(WU_Real_Losses_L ~ ., data = train_fold,
kmax = k_val, kernel = "rectangular", distance = 2)
pred <- predict(model, test_fold)
# Misclassification rate
cv_results$MisclassRate[f] <- mean(pred != test_fold$WU_Real_Losses_L)
}
# Show results
cv_results
mean(cv_results$MisclassRate)
# We create the data split for kNN. Our target variable is WU_Real_Losses_L
split <- createDataPartition(data_baixa$WU_Real_Losses_L, p=0.8, list=FALSE)
train_data <- data_baixa[split, ]
test_data <- data_baixa[-split, ]
#Classifier
x_train_data <- subset(train_data, select = -c(WU_Real_Losses_L, WU_NRW, WU_Real_Losses, WU_NRW_L))
y_train_data <- factor(train_data$WU_Real_Losses_L,
levels = c("Good", "Medium", "Unsatisfactory", "NR"))
x_test_data  <- subset(test_data, select = -c(WU_Real_Losses_L, WU_NRW, WU_Real_Losses, WU_NRW_L))
y_test_data <- factor(test_data$WU_Real_Losses_L,
levels = c("Good", "Medium", "Unsatisfactory", "NR"))
x_train_data[] <- lapply(x_train_data, function(x) if(is.factor(x) | is.character(x)) as.numeric(as.factor(x)) else x)
x_test_data[]  <- lapply(x_test_data,  function(x) if(is.factor(x) | is.character(x)) as.numeric(as.factor(x)) else x)
#Standardise data
preProcValues <- preProcess(x_train_data, method = c("center", "scale"))
x_train_scaled <- predict(preProcValues, x_train_data)
x_test_scaled  <- predict(preProcValues, x_test_data)
k_value <- 3
y_test_pred <- knn(
train = x_train_scaled,
test = x_test_scaled,
cl = y_train_data,
k = k_value
)
confusionMatrix(y_test_pred, y_test_data)
