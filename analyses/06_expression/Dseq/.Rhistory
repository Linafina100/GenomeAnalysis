numeric_cols <- names(data_baixa)[sapply(data_baixa, is.numeric)]
# Split the columns depending on the mean value
small_scale <- numeric_cols[sapply(data_baixa[, numeric_cols], function(x) mean(x, na.rm = TRUE) < 1000)]
medium_scale <- numeric_cols[sapply(data_baixa[, numeric_cols], function(x) mean(x, na.rm = TRUE) >= 1000 & mean(x, na.rm = TRUE) < 100000)]
large_scale <- numeric_cols[sapply(data_baixa[, numeric_cols], function(x) mean(x, na.rm = TRUE) >= 100000)]
# Long mariginal for long labels
par(mar = c(10, 4, 4, 2))
boxplot(data_baixa[, small_scale],
main = "Small Scale Variables",
las = 2,             # roterade labels
cex.axis = 0.6,      # mindre text på axlar
col = "lightgreen",
pch = 4)
boxplot(data_baixa[, medium_scale],
main = "Medium Scale Variables",
las = 2,
cex.axis = 0.6,
col = "lightblue",
pch = 4)
boxplot(data_baixa[, large_scale],
main = "Baixa: Large Scale Variables",
las = 2,
cex.axis = 0.6,
col = "lightcoral",
pch = 4)
data_baixa_fixed <- data_baixa
numeric_cols <- names(data_baixa_fixed)[sapply(data_baixa_fixed, is.numeric)]
# Replace 0 or negative values with NA
data_baixa_fixed[numeric_cols] <- lapply(data_baixa_fixed[numeric_cols], function(x) {
x[x <= 0] <- NA
return(x)
})
# Make the overall plot window larger
options(repr.plot.width = 12, repr.plot.height = 10)
# Set layout and margins
par(mfrow = c(1, 2),
mar = c(12, 5, 4, 2),  # larger margins
cex.axis = 0.8,
cex.main = 1.1)
# Fewer variables per plot
vars_per_plot <- 6
n <- length(numeric_cols)
for (i in seq(1, n, vars_per_plot)) {
cols_subset <- numeric_cols[i:min(i + vars_per_plot - 1, n)]
boxplot(data_baixa_fixed[, cols_subset],
log = "y",
main = paste("Boxplots (log scale)", i, "-", min(i + vars_per_plot - 1, n)),
las = 2,                 # vertical labels
cex.axis = 0.7,
cex.names = 0.65,        # smaller x-axis labels
col = "lightgreen",
pch = 4)
}
