#library(ggvis)
filtered_variables = read_excel("/Users/linamuller/Data Mining/Relatório_Indicadores_Dados_2021.xlsx", sheet=4)
filtered_indicators =read_excel("/Users/linamuller/Data Mining/Relatório_Indicadores_Dados_2021.xlsx", sheet=2)
names(filtered_indicators)[4] <- "TipoSistema"
data_var_baixa <- filtered_variables %>%
filter(TipoSistema == "Baixa") %>%
pivot_wider(
names_from = Variavel,
values_from = Valor,
id_cols = Empresa
)
data_var_alta <- filtered_variables %>%
filter(TipoSistema == "Alta") %>%
pivot_wider(
names_from = Variavel,
values_from = Valor,
id_cols = Empresa
)
data_ind_baixa <- filtered_indicators %>%
filter(TipoSistema == "Baixa") %>%
pivot_wider(
names_from = Indicador,
values_from = Valor,
id_cols = Empresa
)
data_ind_alta <- filtered_indicators %>%
filter(TipoSistema == "Alta") %>%
pivot_wider(
names_from = Indicador,
values_from = Valor,
id_cols = Empresa
)
for (col in names(data_var_alta)) {
if (is.character(data_var_alta[[col]]) | is.factor(data_var_alta[[col]])) {
data_var_alta[[col]][data_var_alta[[col]] %in% c("NA", "NR")] <- NA
}
}
for (col in names(data_var_baixa)) {
if (is.character(data_var_baixa[[col]]) | is.factor(data_var_baixa[[col]])) {
data_var_baixa[[col]][data_var_baixa[[col]] %in% c("NA", "NR")] <- NA
}
}
for (col in names(data_ind_alta)){
data_ind_alta[[col]] <- ifelse(data_ind_alta[[col]] == "NR", "-1",data_ind_alta[[col]])
}
for (col in names(data_ind_baixa)){
data_ind_baixa[[col]] <- ifelse(data_ind_baixa[[col]] == "NR", "-1",data_ind_baixa[[col]])
}
colnames(data_var_alta) <- paste0("V_", colnames(data_var_alta))
colnames(data_var_baixa) <- paste0("V_", colnames(data_var_baixa))
colnames(data_ind_alta) <- paste0("I_", colnames(data_ind_alta))
colnames(data_ind_baixa) <- paste0("I_", colnames(data_ind_baixa))
names(data_var_alta)[1] <- "Empresa"
names(data_var_baixa)[1] <- "Empresa"
names(data_ind_alta)[1] <- "Empresa"
names(data_ind_baixa)[1] <- "Empresa"
# We merge through the variable Empresa
data_baixa = merge.data.frame(data_var_baixa, data_ind_baixa, by = "Empresa")
data_alta = merge.data.frame(data_var_alta, data_ind_alta, by = "Empresa")
for (col in names(data_alta)) {
if (!is.list(data_alta[[col]]) && !is.data.frame(data_alta[[col]])) {
data_alta[[col]] <- as.factor(data_alta[[col]])
} else {
message("Skipped list column: ", col)
}
}
for (col in names(data_baixa)) {
if (!is.list(data_baixa[[col]]) && !is.data.frame(data_baixa[[col]])) {
data_baixa[[col]] <- as.factor(data_baixa[[col]])
} else {
message("Skipped list column: ", col)
}
}
# Some variables are lists and sometimes instead of having just a value, they have a vector of the same value repeated, so we only take the first value and we flatten the list
for (col in names(data_alta)) {
if (is.list(data_alta[[col]])) {
# Replace each list element by its first value
data_alta[[col]] <- sapply(data_alta[[col]], function(x) x[1])
}
}
for (col in names(data_baixa)) {
if (is.list(data_baixa[[col]])) {
# Replace each list element by its first value
data_baixa[[col]] <- sapply(data_baixa[[col]], function(x) x[1])
}
}
# Convert all the variables into factors  so that afterwards we can convert them into numeric
for (col in names(data_baixa)) {
# Work only on factor/character columns
if (is.factor(data_baixa[[col]]) || is.character(data_baixa[[col]])) {
temp <- as.character(data_baixa[[col]])
temp <- gsub(",", ".", temp)
suppressWarnings(num_temp <- as.numeric(temp))
non_na_ratio <- mean(!is.na(num_temp))
if (non_na_ratio > 0.1) {
data_baixa[[col]] <- num_temp
message("Converted to numeric: ", col)
} else {
data_baixa[[col]] <- as.factor(temp)
message("Kept as factor: ", col)
}
}
}
for (col in names(data_alta)) {
# Work only on factor columns (or character columns after unlisting)
if (is.factor(data_alta[[col]]) || is.character(data_alta[[col]])) {
# Convert to character for checking
temp <- as.character(data_alta[[col]])
# Replace commas with dots (handles "12,3" style decimals)
temp <- gsub(",", ".", temp)
# Try converting to numeric
suppressWarnings(num_temp <- as.numeric(temp))
# Check: if most non-missing values are numeric, assume it's a numeric column
non_na_ratio <- mean(!is.na(num_temp))
if (non_na_ratio > 0.1) {  # you can adjust the threshold
data_alta[[col]] <- num_temp
message("Converted to numeric: ", col)
} else {
# Leave as factor if not numeric
data_alta[[col]] <- as.factor(temp)
message("Kept as factor: ", col)
}
}
}
for (col in names(data_alta)) {
# Check if column has any NA values
if (any(is.na(data_alta[[col]]))) {
cat("Imputing missing values in:", col, "\n")
# Only impute if column is numeric
if (is.numeric(data_alta[[col]])) {
# Calculate mean excluding NA and -1
mean_value <- mean(data_alta[[col]][data_alta[[col]] != -1], na.rm = TRUE)
# Impute NAs
data_alta[[col]][is.na(data_alta[[col]])] <- mean_value
}
}
}
for (col in names(data_baixa)) {
# Check if column has any NA values
if (any(is.na(data_baixa[[col]]))) {
cat("Imputing missing values in:", col, "\n")
# Only impute if column is numeric
if (is.numeric(data_baixa[[col]])) {
# Calculate mean excluding NA and -1
mean_value <- mean(data_baixa[[col]][data_baixa[[col]] != -1], na.rm = TRUE)
# Impute NAs
data_baixa[[col]][is.na(data_baixa[[col]])] <- mean_value
}
}
}
