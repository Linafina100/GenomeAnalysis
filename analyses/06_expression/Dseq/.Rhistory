# --- 1. Förbered dataset ---
x_data <- subset(data_baixa, select = -c(WU_Real_Losses_L, WU_NRW, WU_Real_Losses, WU_NRW_L))
y_data <- factor(data_baixa$WU_Real_Losses_L, levels = c("Good","Medium","Unsatisfactory","NR"))
# --- 2. Konvertera factor/character → numeriska ---
x_data[] <- lapply(x_data, function(x) if(is.factor(x) | is.character(x)) as.numeric(as.factor(x)) else x)
x_data <- as.data.frame(x_data)
# --- 3. Ta bort kolumner med noll varians ---
zero_var_cols <- which(apply(x_data, 2, function(x) var(x) == 0))
if(length(zero_var_cols) > 0){
x_data <- x_data[, -zero_var_cols]
}
data_knn <- cbind(WU_Real_Losses_L = y_data, x_data)
# --- 4. Skapa 5-fold CV index ---
set.seed(123)
folds <- sample(rep(1:5, length.out = nrow(data_knn)))
k_val <- 5  # välj k för denna CV
cv_results <- data.frame(Fold = 1:5, MisclassRate = NA)
# --- 5. Loop över folds ---
for(f in 1:5){
train_fold <- data_knn[folds != f, ]
test_fold  <- data_knn[folds == f, ]
model <- train.kknn(WU_Real_Losses_L ~ ., data = train_fold,
kmax = k_val, kernel = "rectangular", distance = 2)
pred <- predict(model, test_fold)
# Misclassification rate
cv_results$MisclassRate[f] <- mean(pred != test_fold$WU_Real_Losses_L)
}
# --- 6. Visa resultat ---
cv_results
mean(cv_results$MisclassRate)  # genomsnittlig felprocent över folds
