final_model <- train.kknn(WU_Real_Losses_L ~ ., data = data_knn, kmax = best_k, kernel="rectangular")
pred <- predict(final_model, data_knn)
# --- 8. Visa confusion matrix ---
table(Predicted = pred, Actual = y_data)
# --- 1. Dataset ---
x_data <- subset(data_baixa, select = -c(WU_Real_Losses_L, WU_NRW, WU_Real_Losses, WU_NRW_L))
y_data <- factor(data_baixa$WU_Real_Losses_L, levels = c("Good","Medium","Unsatisfactory","NR"))
# --- 2. Konvertera factor/character → numeriska ---
x_data[] <- lapply(x_data, function(x) if(is.factor(x) | is.character(x)) as.numeric(as.factor(x)) else x)
x_data <- as.data.frame(x_data)
# --- 3. Ta bort noll-varians kolumner ---
zero_var_cols <- which(apply(x_data, 2, function(x) var(x) == 0))
if(length(zero_var_cols) > 0){
x_data <- x_data[, -zero_var_cols]
}
# --- 4. Skapa dataset för kknn ---
data_knn <- cbind(WU_Real_Losses_L = y_data, x_data)
# --- 5. Testa olika k och spara misclassification rate ---
k_values <- c(3,5,7,9,11)
results <- data.frame(k = k_values, misclass = NA)
for(i in seq_along(k_values)){
model <- train.kknn(WU_Real_Losses_L ~ ., data = data_knn,
kmax = k_values[i], kernel = "rectangular", distance = 2)
# MISCLASS är andelen felklassade
results$misclass[i] <- model$MISCLASS
}
# --- 6. Plot misclassification vs k ---
ggplot(results, aes(x = k, y = misclass)) +
geom_point(size = 3, color = "blue") +
geom_line(color = "blue") +
scale_y_continuous(labels = scales::percent_format(accuracy = 1)) +
labs(title = "Misclassification Rate vs k in kNN",
x = "k (number of neighbors)",
y = "Misclassification Rate") +
theme_minimal()
